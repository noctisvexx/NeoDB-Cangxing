# ── NeoDB ─────────────────────────────────────────────
# 你的 NeoDB 实例地址（自建实例请改成自己的域名）
NEO_DB_INSTANCE=https://neodb.social

# NeoDB OAuth（推荐）：在 https://neodb.social/developer/ 登录后新增应用（权限默认 read+write），
# Redirect URI 填 http://localhost:3000/api/auth/callback，
# 创建后把 Client ID 与 Client Secret 填到下面。
# 配置后可在「我的」页面一键连接，获得一年期 read+write 令牌。
NEO_DB_CLIENT_ID=
NEO_DB_CLIENT_SECRET=
NEO_DB_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 手动 Test Access Token（备选，有效期很短）：
# 打开 https://neodb.social/developer/ 登录后生成。
NEO_DB_ACCESS_TOKEN=

# ── TMDB（推荐）───────────────────────────────────────
# 在 https://www.themoviedb.org/settings/api 免费申请 API Key。
# 配置后首页电影/剧集/动漫切换为 TMDB 热门，并显示 TMDB 评分。
TMDB_API_KEY=

# ── OMDb（可选，IMDb 评分）────────────────────────────
# IMDb 无官方 API，用 https://www.omdbapi.com/apikey.aspx 免费 Key 显示 IMDb 评分。
OMDB_API_KEY=
